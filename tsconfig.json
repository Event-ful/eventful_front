{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Node",
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],

    "paths": {
      "@/*": ["./src/*"],
      "@/components/*": ["./src/components/*"],
      "@/pages/*": ["./src/pages/*"],
      "@/utils/*": ["./src/utils/*"]
    },

    "types": ["vite/client", "vite-plugin-svgr/client"]
  },
  "files": [],
  "references": [{ "path": "./tsconfig.node.json" }],
  "include": ["src"]
}
